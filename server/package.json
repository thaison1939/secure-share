{
  "name": "secure-share-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env development",
    "deploy:prod": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "secret:put": "wrangler secret put",
    "type-check": "tsc --noEmit",
    "setup-secrets": "echo 'Run: npm run secret:put UPLOAD_AUTH_SECRET && npm run secret:put UPSTASH_REDIS_REST_URL && npm run secret:put UPSTASH_REDIS_REST_TOKEN'"
  },
  "dependencies": {
    "hono": "^3.12.0",
    "@upstash/redis": "^1.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.60.0"
  }
}